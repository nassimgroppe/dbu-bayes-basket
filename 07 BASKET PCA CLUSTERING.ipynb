 "cells": [
  {
   "cell_type": "markdown",
   "id": "cell-0",
   "metadata": {},
   "source": [
    "# Basket Trading — PCA & Clustering\n",
    "\n",
    "**CRISP-DM Phase:** Modeling  \n",
    "**Ziel:** Aktien anhand ihrer Renditemuster clustern, um diversifizierte Baskets für das Basket-Trading-System zu konstruieren.  \n",
    "PCA reduziert die Renditekorrelationsstruktur, K-Means gruppiert ähnliche Aktien."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-1",
   "metadata": {},
   "source": [
    "## 1. Setup & Datenimport"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-2",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.metrics import silhouette_score\n",
    "from sklearn.impute import SimpleImputer\n",
    "\n",
    "RANDOM_STATE  = 42\n",
    "PROCESSED_DIR = Path(\"/Users/lisagroppe/Desktop/data/processed\")\n",
    "RAW_DIR       = Path(\"/Users/lisagroppe/Desktop/data/raw\")\n",
    "\n",
    "sns.set_style(\"whitegrid\")\n",
    "plt.rcParams[\"figure.dpi\"] = 110"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-3",
   "metadata": {},
   "outputs": [],
   "source": [
    "prices_df       = pd.read_parquet(PROCESSED_DIR / \"prices_cleaned.parquet\")\n",
    "fundamentals_df = pd.read_csv(PROCESSED_DIR / \"fundamentals_cleaned.csv\")\n",
    "\n",
    "prices_df[\"date\"] = pd.to_datetime(prices_df[\"date\"])\n",
    "prices_df = prices_df.sort_values([\"ticker\", \"date\"]).reset_index(drop=True)\n",
    "\n",
    "print(f\"Preisdaten:       {prices_df.shape}\")\n",
    "print(f\"Fundamentaldaten: {fundamentals_df.shape}\")\n",
    "print(f\"Zeitraum: {prices_df['date'].min().date()} bis {prices_df['date'].max().date()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-4",
   "metadata": {},
   "source": [
    "## 2. Feature-Matrix für Clustering\n",
    "\n",
    "Für jede Aktie werden aggregierte Kennzahlen berechnet — eine Zeile pro Ticker.  \n",
    "Diese Cross-Sectional-Matrix bildet die Basis für PCA und K-Means."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "prices_df[\"momentum_12m\"] = prices_df.groupby(\"ticker\")[\"close\"].transform(\n",
    "    lambda s: s.pct_change(252)\n",
    ")\n",
    "prices_df[\"momentum_3m\"] = prices_df.groupby(\"ticker\")[\"close\"].transform(\n",
    "    lambda s: s.pct_change(63)\n",
    ")\n",
    "prices_df[\"volatility_30d\"] = prices_df.groupby(\"ticker\")[\"daily_return\"].transform(\n",
    "    lambda s: s.rolling(30, min_periods=10).std()\n",
    ")\n",
    "\n",
    "# Ticker-Profil: Aggregation über gesamten Zeitraum\n",
    "ticker_profile = prices_df.groupby(\"ticker\").agg(\n",
    "    mean_return     = (\"daily_return\",  \"mean\"),\n",
    "    std_return      = (\"daily_return\",  \"std\"),\n",
    "    mean_volume_z   = (\"volume_zscore\", \"mean\"),\n",
    "    mean_momentum12 = (\"momentum_12m\",  \"mean\"),\n",
    "    mean_momentum3  = (\"momentum_3m\",   \"mean\"),\n",
    "    mean_volatility = (\"volatility_30d\",\"mean\"),\n",
    "    skew_return     = (\"daily_return\",  \"skew\"),\n",
    ").reset_index()\n",
    "\n",
    "# Fundamentaldaten anfügen\n",
    "fund_features = fundamentals_df[[\"ticker\", \"pe_ratio\", \"dividend_yield\",\n",
    "                                  \"price_to_book\", \"market_cap\", \"sector\", \"index_name\"]]\n",
    "ticker_profile = ticker_profile.merge(fund_features, on=\"ticker\", how=\"left\")\n",
    "\n",
    "print(f\"Ticker im Profil: {len(ticker_profile)}\")\n",
    "print(ticker_profile.head(3).to_string())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-6",
   "metadata": {},
   "source": [
    "## 3. Standardisierung & PCA"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7",
   "metadata": {},
   "outputs": [],
   "source": [
    "feature_cols = [\"mean_return\", \"std_return\", \"mean_volume_z\",\n",
    "                \"mean_momentum12\", \"mean_momentum3\", \"mean_volatility\",\n",
    "                \"skew_return\", \"pe_ratio\", \"dividend_yield\",\n",
    "                \"price_to_book\", \"market_cap\"]\n",
    "\n",
    "X_raw = ticker_profile[feature_cols].copy()\n",
    "\n",
    "# Fehlwerte imputen (median) bevor Skalierung\n",
    "imputer  = SimpleImputer(strategy=\"median\")\n",
    "X_imp    = imputer.fit_transform(X_raw)\n",
    "\n",
    "scaler   = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X_imp)\n",
    "\n",
    "pca_full = PCA(random_state=RANDOM_STATE)\n",
    "pca_full.fit(X_scaled)\n",
    "\n",
    "explained  = pca_full.explained_variance_ratio_\n",
    "cumulative = np.cumsum(explained)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "\n",
    "axes[0].bar(range(1, len(explained)+1), explained, color=\"steelblue\", edgecolor=\"white\")\n",
    "axes[0].set_xlabel(\"Hauptkomponente\")\n",
    "axes[0].set_ylabel(\"Erklärte Varianz\")\n",
    "axes[0].set_title(\"Scree Plot — DAX/MDAX Aktien-Features\")\n",
    "\n",
    "axes[1].plot(range(1, len(cumulative)+1), cumulative, marker=\"o\", color=\"steelblue\")\n",
    "axes[1].axhline(0.80, color=\"red\",    linestyle=\"--\", label=\"80%\")\n",
    "axes[1].axhline(0.90, color=\"orange\", linestyle=\"--\", label=\"90%\")\n",
    "axes[1].set_xlabel(\"Anzahl Komponenten\")\n",
    "axes[1].set_ylabel(\"Kumulierte Varianz\")\n",
    "axes[1].set_title(\"Kumulierte erklärte Varianz\")\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "for threshold in [0.80, 0.90, 0.95]:\n",
    "    n = np.argmax(cumulative >= threshold) + 1\n",
    "    print(f\"Komponenten für {int(threshold*100)}% Varianz: {n}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-8",
   "metadata": {},
   "source": [
    "## 4. Rendite-Korrelationsmatrix (Asset-Ebene)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pivot: Zeilen = Datum, Spalten = Ticker\n",
    "ret_pivot = prices_df.pivot_table(index=\"date\", columns=\"ticker\", values=\"daily_return\")\n",
    "ret_pivot = ret_pivot.dropna(thresh=int(len(ret_pivot) * 0.8), axis=1)\n",
    "\n",
    "# PCA auf Rendite-Matrix (Aktien als Beobachtungen)\n",
    "ret_filled = ret_pivot.fillna(ret_pivot.median())\n",
    "scaler_ret = StandardScaler()\n",
    "ret_scaled = scaler_ret.fit_transform(ret_filled.T)  # Transponiert: Aktien als Zeilen\n",
    "\n",
    "pca2 = PCA(n_components=2, random_state=RANDOM_STATE)\n",
    "X_pca2 = pca2.fit_transform(ret_scaled)\n",
    "\n",
    "df_pca = pd.DataFrame(X_pca2, columns=[\"PC1\", \"PC2\"])\n",
    "df_pca[\"ticker\"] = ret_pivot.columns.tolist()\n",
    "df_pca = df_pca.merge(fundamentals_df[[\"ticker\", \"sector\", \"index_name\"]], on=\"ticker\", how=\"left\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 9))\n",
    "sectors = df_pca[\"sector\"].fillna(\"Unbekannt\").unique()\n",
    "palette = dict(zip(sectors, sns.color_palette(\"tab20\", len(sectors))))\n",
    "\n",
    "for sector, grp in df_pca.groupby(df_pca[\"sector\"].fillna(\"Unbekannt\")):\n",
    "    ax.scatter(grp[\"PC1\"], grp[\"PC2\"], label=sector,\n",
    "               color=palette[sector], s=60, alpha=0.85)\n",
    "\n",
    "for _, row in df_pca.iterrows():\n",
    "    ax.annotate(row[\"ticker\"], (row[\"PC1\"], row[\"PC2\"]),\n",
    "                fontsize=6, alpha=0.7, xytext=(3, 3), textcoords=\"offset points\")\n",
    "\n",
    "ax.set_xlabel(f\"PC1 ({pca2.explained_variance_ratio_[0]*100:.1f}% Varianz)\")\n",
    "ax.set_ylabel(f\"PC2 ({pca2.explained_variance_ratio_[1]*100:.1f}% Varianz)\")\n",
    "ax.set_title(\"PCA der Rendite-Zeitreihen — DAX40 + MDAX50 Aktien nach Sektor\")\n",
    "ax.legend(loc=\"upper right\", fontsize=7, ncol=2)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-10",
   "metadata": {},
   "source": [
    "## 5. K-Means Clustering — Optimale Basket-Gruppen"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-11",
   "metadata": {},
   "outputs": [],
   "source": [
    "inertias    = []\n",
    "silhouettes = []\n",
    "k_range     = range(2, 12)\n",
    "\n",
    "for k in k_range:\n",
    "    km = KMeans(n_clusters=k, random_state=RANDOM_STATE, n_init=20)\n",
    "    labels = km.fit_predict(ret_scaled)\n",
    "    inertias.append(km.inertia_)\n",
    "    silhouettes.append(silhouette_score(ret_scaled, labels))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "axes[0].plot(k_range, inertias,    marker=\"o\", color=\"steelblue\")\n",
    "axes[0].set_title(\"Elbow-Methode\")\n",
    "axes[0].set_xlabel(\"k\")\n",
    "axes[0].set_ylabel(\"Inertia\")\n",
    "\n",
    "axes[1].plot(k_range, silhouettes, marker=\"o\", color=\"coral\")\n",
    "axes[1].set_title(\"Silhouette Score\")\n",
    "axes[1].set_xlabel(\"k\")\n",
    "axes[1].set_ylabel(\"Silhouette Score\")\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "best_k = list(k_range)[np.argmax(silhouettes)]\n",
    "print(f\"Bestes k: {best_k}  (Silhouette: {max(silhouettes):.4f})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-12",
   "metadata": {},
   "source": [
    "## 6. Basket-Zusammensetzung"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-13",
   "metadata": {},
   "outputs": [],
   "source": [
    "km_best = KMeans(n_clusters=best_k, random_state=RANDOM_STATE, n_init=20)\n",
    "df_pca[\"cluster\"] = km_best.fit_predict(ret_scaled)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 9))\n",
    "palette_c = sns.color_palette(\"tab10\", best_k)\n",
    "\n",
    "for c in range(best_k):\n",
    "    mask = df_pca[\"cluster\"] == c\n",
    "    ax.scatter(df_pca.loc[mask, \"PC1\"], df_pca.loc[mask, \"PC2\"],\n",
    "               label=f\"Basket {c+1}\", color=palette_c[c], s=70, alpha=0.85)\n",
    "\n",
    "for _, row in df_pca.iterrows():\n",
    "    ax.annotate(row[\"ticker\"], (row[\"PC1\"], row[\"PC2\"]),\n",
    "                fontsize=6.5, alpha=0.8, xytext=(3, 3), textcoords=\"offset points\")\n",
    "\n",
    "ax.set_xlabel(\"PC1\")\n",
    "ax.set_ylabel(\"PC2\")\n",
    "ax.set_title(f\"K-Means (k={best_k}) — Basket-Gruppen im PCA-Raum\")\n",
    "ax.legend(fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nBasket-Zusammensetzung:\")\n",
    "for c in range(best_k):\n",
    "    tickers = df_pca.loc[df_pca[\"cluster\"] == c, \"ticker\"].tolist()\n",
    "    print(f\"\\nBasket {c+1} ({len(tickers)} Aktien): {', '.join(tickers)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-14",
   "metadata": {},
   "source": [
    "## 7. Basket-Performance Vergleich"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-15",
   "metadata": {},
   "outputs": [],
   "source": [
    "basket_map = df_pca.set_index(\"ticker\")[\"cluster\"].to_dict()\n",
    "prices_df[\"basket\"] = prices_df[\"ticker\"].map(basket_map)\n",
    "\n",
    "basket_returns = prices_df.dropna(subset=[\"basket\", \"daily_return\"]).groupby(\n",
    "    [\"date\", \"basket\"]\n",
    ")[\"daily_return\"].mean().reset_index()\n",
    "\n",
    "basket_cum = basket_returns.pivot(index=\"date\", columns=\"basket\", values=\"daily_return\")\n",
    "basket_cum = (1 + basket_cum).cumprod()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 6))\n",
    "for c in range(best_k):\n",
    "    if c in basket_cum.columns:\n",
    "        basket_cum[c].plot(ax=ax, label=f\"Basket {c+1}\", linewidth=1.5)\n",
    "\n",
    "ax.set_title(\"Kumulierte Rendite je Basket (gleichgewichtet)\")\n",
    "ax.set_ylabel(\"Kumulierte Rendite (1 = Startkapital)\")\n",
    "ax.set_xlabel(\"Datum\")\n",
    "ax.legend()\n",
    "ax.axhline(1, color=\"black\", linewidth=0.8, linestyle=\"--\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nPerformance-Kennzahlen je Basket:\")\n",
    "stats = basket_returns.groupby(\"basket\")[\"daily_return\"].agg(\n",
    "    mean_return=\"mean\",\n",
    "    volatility=\"std\",\n",
    ").assign(\n",
    "    sharpe=lambda d: d[\"mean_return\"] / d[\"volatility\"] * np.sqrt(252)\n",
    ").round(5)\n",
    "print(stats)"
   ]
  }
 ],
